{
  "Workbook": {
    "Path": "samples/complaint-list.xlsx",
    "Sheet": "Complaints",
    "HeaderRow": 2,
    "Columns": {
      "CaseId": "CaseId",
      "ReceivedDate": "ReceivedDate",
      "Category": "Category",
      "ProductGroup": "ProductGroup",
      "Batch": "Batch",
      "Severity": "Severity",
      "Status": "Status",
      "SampleReceived": "SampleReceived",
      "Description": "Description"
    }
  },
  "Selection": {
    "OpenStatuses": ["Open"]
  },
  "CaseFolders": {
    "Path": "samples/case-folders",
    "TextExtensions": [".txt", ".md"],
    "MaxCharsPerDocument": 4000
  },
  "SimilarComplaints": {
    "LookbackMonths": 12,
    "RecentDays": 30
  },
  "Prompt": {
    "MaskContactData": true
  },
  "Reports": {
    "Short": {
      "Marker": "short.txt",
      "Title": "Complaint report (short)",
      "PromptPath": "prompts/short-report.txt",
      "RequiredSections": ["Complaint", "Similar complaints", "Assessment", "Conclusion"]
    },
    "Long": {
      "Marker": "long.txt",
      "Title": "Complaint report (long)",
      "PromptPath": "prompts/long-report.txt",
      "RequiredSections": ["Complaint", "Previous complaints", "Returned sample", "Investigation so far", "Assessment", "Proposed actions", "Conclusion"],
      "NoSampleStatement": "No returned sample was available for examination."
    }
  },
  "Report": {
    "TemplatePath": "templates/report-template.docx",
    "OutputPath": "out"
  },
  "Demo": {
    "ResponsePath": "samples/demo-responses"
  },
  "Copilot": {
    "WindowTitle": "Microsoft 365 Copilot",
    "PreferredModel": "",
    "PreferredModelGroup": "",
    "TemporaryChat": true,
    "Upload": {
      "Path": "",
      "Extensions": [".pdf", ".docx", ".xlsx", ".csv", ".png", ".jpg"],
      "MaxFiles": 3,
      "MaxFileSizeMB": 10
    },
    "StartDelaySeconds": 3,
    "NewChatTimeoutSeconds": 30,
    "UploadTimeoutSeconds": 60,
    "ResponseTimeoutSeconds": 240,
    "StableReadyChecks": 3,
    "PollMilliseconds": 1000,
    "ModelMenuTimeoutMilliseconds": 3000
  }
}
