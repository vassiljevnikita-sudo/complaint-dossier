{
  "Workbook": {
    "Path": "samples/complaint-list.xlsx",
    "Sheet": "Complaints",
    "HeaderRow": 2,
    "Columns": {
      "CaseId": "CaseId",
      "ReceivedDate": "ReceivedDate",
      "Category": "Category",
      "ProductGroup": "ProductGroup",
      "Batch": "Batch",
      "Severity": "Severity",
      "Status": "Status",
      "SampleReceived": "SampleReceived",
      "Description": "Description"
    }
  },
  "Selection": {
    "OpenStatuses": [
      "Open"
    ]
  },
  "CaseFolders": {
    "Path": "samples/case-folders",
    "TextExtensions": [
      ".txt",
      ".md"
    ],
    "MaxCharsPerDocument": 4000
  },
  "SimilarComplaints": {
    "LookbackMonths": 12,
    "RecentDays": 30,
    "FrequencyLevels": [
      {
        "MinCases": 0,
        "Level": "rare"
      },
      {
        "MinCases": 1,
        "Level": "occasional"
      },
      {
        "MinCases": 3,
        "Level": "frequent"
      },
      {
        "MinCases": 6,
        "Level": "very frequent"
      }
    ]
  },
  "Prompt": {
    "MaskContactData": true
  },
  "Reports": {
    "Short": {
      "Marker": "short.txt",
      "Title": "Complaint report (short)",
      "PromptPath": "prompts/short-report.txt",
      "RequiredSections": [
        "Basic complaint data",
        "1. Technical description and categorisation of the defect",
        "2. Statistical and historical classification",
        "3. Assessment of the available information",
        "4. Conclusion"
      ],
      "FrequencyStatement": "The reported defect is classified as {LEVEL}.",
      "ProcessFacts": [
        "The batch record was reviewed and showed no findings."
      ]
    },
    "Long": {
      "Marker": "long.txt",
      "Title": "Complaint report (long)",
      "PromptPath": "prompts/long-report.txt",
      "RequiredSections": [
        "Basic complaint data",
        "1. Technical description and categorisation of the defect",
        "2. Previous complaints for the same batch",
        "3. Previous complaints for the same product",
        "4. Examination of the returned complaint sample",
        "5. Result of the batch record review",
        "6. Result of the review of analyses and retained samples",
        "7. Assessment of a possible manufacturing defect",
        "8. Status of existing or initiated corrective actions",
        "9. Risk assessment and overall conclusion"
      ],
      "NoSampleStatement": "No complaint sample was available for the investigation.",
      "ProcessFacts": [
        "The batch record was reviewed and showed no findings.",
        "Retained samples did not need to be checked."
      ],
      "ClassificationStatements": [
        "The complaint is classified as justified.",
        "The complaint is classified as not justified."
      ]
    }
  },
  "Report": {
    "TemplatePath": "templates/report-template.docx",
    "OutputPath": "out"
  },
  "Demo": {
    "ResponsePath": "samples/demo-responses"
  },
  "Copilot": {
    "WindowTitle": "Microsoft 365 Copilot",
    "PreferredModel": "",
    "PreferredModelGroup": "",
    "TemporaryChat": true,
    "Upload": {
      "Path": "",
      "Extensions": [
        ".pdf",
        ".docx",
        ".xlsx",
        ".csv",
        ".png",
        ".jpg"
      ],
      "MaxFiles": 3,
      "MaxFileSizeMB": 10
    },
    "StartDelaySeconds": 3,
    "NewChatTimeoutSeconds": 30,
    "UploadTimeoutSeconds": 60,
    "ResponseTimeoutSeconds": 240,
    "StableReadyChecks": 3,
    "PollMilliseconds": 1000,
    "ModelMenuTimeoutMilliseconds": 3000
  }
}
